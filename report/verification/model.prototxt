name: "U-Net-2D-7-32"
layer {
  name: "loaddata"
  type: "HDF5Data"
  top: "data"
  top: "labels"
  top: "weights"
  top: "weights2"
  include {
    phase: TRAIN
  }
  hdf5_data_param {
    source: ".cache/u-net/unet-2ecdd8a7-a865-4600-9228-3072dcaacc1b-trainfilelist.txt"
    batch_size: 1
    shuffle: false
  }
}
layer {
  name: "create_deformation"
  type: "CreateDeformation"
  bottom: "weights2"
  top: "def"
  include {
    phase: TRAIN
  }
  create_deformation_param {
    batch_size: 1
    ny: 1788
    nx: 1788
    ncomponents: 2
    random_elastic_grid_spacing {
      v: 150
      v: 150
    }
    random_elastic_deform_magnitude {
      v: 10.0
      v: 10.0
    }
    random_rotate_from {
      v: 0.0
    }
    random_rotate_to {
      v: 360.0
    }
    random_offset_from {
      v: -64.0
      v: -64.0
    }
    random_offset_to {
      v: 64.0
      v: 64.0
    }
    random_offset_range_from_pdf: true
  }
}
layer {
  name: "def_data-data2"
  type: "ApplyDeformation"
  bottom: "data"
  bottom: "def"
  top: "data2"
  include {
    phase: TRAIN
  }
  apply_deformation_param {
    interpolation: "linear"
    extrapolation: "mirror"
  }
}
layer {
  name: "augm_data2-data3"
  type: "ValueAugmentation"
  bottom: "data2"
  top: "data3"
  include {
    phase: TRAIN
  }
  value_augmentation_param {
    black_from: -0.05
    black_to: 0.05
    white_from: 0.95
    white_to: 1.05
    slope_min: 0.8
    slope_max: 1.2
  }
}
layer {
  name: "trafo_data3-d0a"
  type: "ValueTransformation"
  bottom: "data3"
  top: "d0a"
  value_transformation_param {
    offset {
      v: -0.5
    }
  }
}
layer {
  name: "conv_d0a-b"
  type: "Convolution"
  bottom: "d0a"
  top: "d0b"
  param {
    lr_mult: 1.0
    decay_mult: 1.0
  }
  param {
    lr_mult: 2.0
    decay_mult: 0.0
  }
  convolution_param {
    num_output: 16
    pad: 0
    kernel_size: 3
    kernel_size: 3
    weight_filler {
      type: "msra"
    }
  }
}
layer {
  name: "relu_d0b"
  type: "ReLU"
  bottom: "d0b"
  top: "d0b"
  relu_param {
    negative_slope: 0.1
  }
}
layer {
  name: "conv_d0b-c"
  type: "Convolution"
  bottom: "d0b"
  top: "d0c"
  param {
    lr_mult: 1.0
    decay_mult: 1.0
  }
  param {
