    weight_filler {
      type: "msra"
    }
  }
}
layer {
  name: "relu_d0c"
  type: "ReLU"
  bottom: "d0c"
  top: "d0c"
  relu_param {
    negative_slope: 0.1
  }
}
layer {
  name: "pool_d0c-1a"
  type: "Pooling"
  bottom: "d0c"
  top: "d1a"
  pooling_param {
    pool: MAX
    kernel_size: 2
    kernel_size: 2
    stride: 2
    stride: 2
  }
}
