# SFTP-only access for the LysoQuant Fiji plugin, with public keys only.
# Port: set with -o Port=$LYSOQUANT_SSH_PORT by the entrypoint
HostKey /etc/lysoquant/hostkeys/ssh_host_ed25519_key
HostKey /etc/lysoquant/hostkeys/ssh_host_ecdsa_key
HostKey /etc/lysoquant/hostkeys/ssh_host_rsa_key
# The file mounted by compose.yaml (read at every login, so edits apply at once)
# and the keys from $LYSOQUANT_AUTHORIZED_KEYS written by the entrypoint
AuthorizedKeysFile /authorized_keys /etc/lysoquant/authorized_keys
# The mounted file belongs to whoever owns it on the host; nobody else can write in here
StrictModes no

AllowUsers lysoquant
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no

# Fiji ships JSch 0.1.55, which can only sign with ssh-rsa (SHA-1); OpenSSH
# disables it by default
PubkeyAcceptedAlgorithms +ssh-rsa

Subsystem sftp internal-sftp
ForceCommand internal-sftp
PermitTTY no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
LogLevel INFO
