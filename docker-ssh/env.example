# Copy to .env (./setup.sh does it) and adapt.
# Public keys allowed to connect are read from this file (one per line), mounted
# read-only in the container. ./setup.sh creates it from key/lysoquant.key.
#LYSOQUANT_AUTHORIZED_KEYS_FILE=./authorized_keys
# Extra public keys given here (separated by ;), e.g. on hosts where mounting a
# file is not convenient
#LYSOQUANT_AUTHORIZED_KEYS=
# Port of the SSH server (not 22: the same number is used inside the container
# and on the host, open it in the firewall)
LYSOQUANT_SSH_PORT=2222
# "all" (every GPU), "GPU 0,GPU 1", "GPU <n>" or "none" for CPU
# (./setup.sh sets "all" with an NVIDIA GPU and "none" without)
LYSOQUANT_GPU=all
# Size in px of the square tiles the images are segmented in: 4 + 128*k, i.e.
# 132, 260, 388, ... 900, ... 2052. Larger tiles are faster (each tile also reads
# 764 px of context on every side) but need more memory, on the GPU or, without
# a GPU (LYSOQUANT_GPU=none), in RAM. Choose the largest one that fits. Memory
# for one tile, float32 (add a margin for cuDNN workspaces, a few hundred MB):
#   tile (px)    132  260  388  516  644  772  900  1028 1156 1284 1412 1540 1668 1796 1924 2052
#   memory (GB)  1.2  1.3  1.4  1.4  1.5  1.6  1.7  1.8  1.9  2.1  2.2  2.4  2.6  2.8  3.0  3.3
# This is the weights (0.5 GB), the CUDA runtime (0.4 GB) and one tile, and it does
# not depend on the size of the image. See "Tile size and memory" in ../server/README.md
LYSOQUANT_TILE_SIZE=900
# Tiles segmented at the same time on each GPU (one per running job). Each one
# needs its own memory: the weights are shared, so N tiles need about
# 0.9 GB + N x (memory of one tile - 0.9 GB)
LYSOQUANT_TILES_PER_GPU=1
# Image flavour, set by ./setup.sh: CUDA image (default) or CPU image
#LYSOQUANT_BASE_IMAGE=python:3.12-slim
#LYSOQUANT_TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Container is unhealthy if a single job runs longer than this (s)
LYSOQUANT_JOB_TIMEOUT=3600
# Job folders left by crashed clients are deleted after this many hours
LYSOQUANT_KEEP_HOURS=24
